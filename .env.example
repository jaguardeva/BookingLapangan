# Application
APP_DEBUG=true
APP_ENV=local
APP_FAKER_LOCALE=id_ID
APP_FALLBACK_LOCALE=id
APP_KEY=
APP_LOCALE=id
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
APP_NAME=SportBooking
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

# Authentication
AUTH_PASSWORD_RESET_EXPIRE=60
AUTH_REDIRECT_ADMIN=/admin
AUTH_REDIRECT_AFTER_VERIFICATION=/my-bookings
AUTH_REDIRECT_MEMBER=/my-bookings
AUTH_VERIFICATION_EXPIRE=60

# AWS
AWS_ACCESS_KEY_ID=
AWS_BUCKET=
AWS_DEFAULT_REGION=us-east-1
AWS_SECRET_ACCESS_KEY=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cache
# CACHE_PREFIX=
CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1

# Database
DB_CONNECTION=pgsql
DB_DATABASE=laravel_notification
DB_HOST=127.0.0.1
DB_PASSWORD=
DB_PORT=5432
DB_USERNAME=postgres

# Development server
# PHP_CLI_SERVER_WORKERS=4

# Filesystem
FILESYSTEM_DISK=local

# Frontend
VITE_APP_NAME="${APP_NAME}"
VITE_TAWKTO_ENABLED=false
VITE_TAWKTO_PROPERTY_ID=your-property-id
VITE_TAWKTO_WIDGET_ID=your-widget-id

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_STACK=single

# Mail
# MAIL_EHLO_DOMAIN=example.com
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_HOST=live.smtp.mailtrap.io
MAIL_MAILER=smtp
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_SCHEME=smtp
# MAIL_URL=
MAIL_USERNAME=api

# Password hashing
BCRYPT_ROUNDS=12

# Queue
QUEUE_CONNECTION=database

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sessions
SESSION_DOMAIN=null
SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_LIFETIME=120
SESSION_PATH=/

# Site contact
SITE_CONTACT_ADDRESS=
SITE_CONTACT_EMAIL=
SITE_CONTACT_PHONE=
